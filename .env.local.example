# MoodGarden — Environment Variables Template
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# ── Supabase ─────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Web Push (VAPID) ─────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Store in Vercel Environment Variables for production.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:your-email@example.com

# ── Google OAuth ─────────────────────────────────────────
# Created in: Google Cloud Console → Credentials → OAuth 2.0 Client ID
# Also configure the same Client ID in Supabase Auth → Providers → Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Claude API (knowledge-card generation pipeline only) ──
# Used by scripts/build-knowledge-cards.ts — not needed for the app itself
ANTHROPIC_API_KEY=your-anthropic-api-key-here
